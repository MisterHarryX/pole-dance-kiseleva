# Copy to .env.local for local development; on Vercel set these in Project → Settings → Environment Variables.
# Password for the panel at /admin.
ADMIN_PASSWORD=
# Optional: signs the panel session cookie (defaults to a value derived from the password).
ADMIN_SECRET=
ADMIN_TZ=Europe/Moscow
# Upstash Redis (set automatically when a store is connected to the Vercel project).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: Vercel Blob for uploaded photos (otherwise photos go to Redis or .data/media).
BLOB_READ_WRITE_TOKEN=
