{
  "name": "pole-dance-kiseleva",
  "version": "1.0.0",
  "description": "Pole Dance Kiseleva — сайт студии танцев на пилоне (Москва, Новогиреево) с кабинетом /admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "photos": "python -I scripts/photos.py",
    "build:pages": "tsc && vite build --mode pages --base /pole-dance-kiseleva/ --outDir dist-pages --emptyOutDir",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@vercel/blob": "^2.9.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
